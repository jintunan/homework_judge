# Web server
PORT=8787
APP_DATA_DIR=./data
DATABASE_PATH=./data/homework-judge.sqlite
UPLOAD_DIR=./data/uploads
TEMP_DIR=./data/tmp
TEACHER_NAME=本机教师
APP_ENV=production

# Upload and grading limits
MAX_UPLOAD_MB=20
MAX_FILES_PER_BATCH=50
MAX_PDF_PAGES=20
GRADING_CONCURRENCY=2
ANSWER_CONFIG_CONCURRENCY=2
MODEL_TIMEOUT_MS=120000
LOW_CONFIDENCE_THRESHOLD=0.65
ANSWER_SEARCH_CONFIDENCE_THRESHOLD=0.72

# Alibaba Cloud Model Studio (Bailian)
DASHSCOPE_API_KEY=
# Recommended: https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-plus
# Native DashScope endpoint used to return web-search sources.
DASHSCOPE_NATIVE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_SEARCH_MODEL=qwen-plus
