# 阿里云百炼服务端配置（不要把真实 Key 提交到 Git）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3-vl-plus

# 本地服务
PORT=8787
APP_DATA_DIR=./data/runtime
MAX_UPLOAD_MB=30
MAX_DOCUMENT_PAGES=30
MODEL_TIMEOUT_MS=120000
MODEL_RETRY_COUNT=2
MODEL_CONCURRENCY=3
STUDENT_RECOGNITION_CONCURRENCY=3
MODEL_PAGES_PER_BATCH=4
ANSWER_PAGES_PER_BATCH=3
AUTO_MATCH_THRESHOLD=0.82
AUTO_MATCH_MARGIN=0.08
BOUNDARY_MERGE_MIN_CONFIDENCE=0.85
TEACHER_NAME=本机教师

# 作业批改 Agent（完成教师标注校准前建议保持关闭）
GRADING_ENABLED=false
GRADING_CONCURRENCY=2
GRADING_MODEL_TIMEOUT_MS=120000
GRADING_MODEL_RETRY_COUNT=2
GRADING_AUTO_CONFIDENCE_THRESHOLD=0.95
GRADING_RECOGNITION_REVIEW_THRESHOLD=0.85
GRADING_FORMULA_TIMEOUT_MS=1500

# Structured application logs. LOG_FILE_PATH must stay inside APP_DATA_DIR.
LOG_LEVEL=INFO
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
LOG_FILE_PATH=logs/homework-judge.jsonl
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# 可选：LibreOffice soffice.exe 绝对路径
SOFFICE_PATH=
